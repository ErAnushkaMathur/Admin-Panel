# Copy to .env and fill in real values. Never commit .env.

# ---- Server ----
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
# JWT and auth-cookie lifetime in days
JWT_EXPIRES_DAYS=7
# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops in front of the API (e.g. 1 on Render/Railway/Nginx); empty = none.
# Needed so punches record the real client IP.
TRUST_PROXY=
# Max punch-page requests per IP per 10 minutes
PUNCH_RATE_LIMIT_MAX=120
FAST2SMS_API_KEY=

# Client env lives in client/.env (see client/.env.example)
